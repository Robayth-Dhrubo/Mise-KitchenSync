{
  "name": "mise-kitchen-sync",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "export:diagrams": "mmdc -i docs/diagrams/high-level.mmd -o docs/diagrams/high-level.png && mmdc -i docs/diagrams/order-sequence.mmd -o docs/diagrams/order-sequence.png && mmdc -i docs/diagrams/ci-flow.mmd -o docs/diagrams/ci-flow.png",
    "seed:dev": "ts-node scripts/seed-dev.ts",
    "test:watch": "vitest",
    "run-script": "ts-node",
    "db:generate": "drizzle-kit generate",
    "dev:next": "next dev",
    "build:next": "next build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.93.3",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.563.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "openai": "^6.21.0",
    "playwright-core": "^1.58.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.71.1",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6",
    "drizzle-orm": "0.45.2"
